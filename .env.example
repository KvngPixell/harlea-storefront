# Copy this file to `.env` for local development. NEVER commit real values.
# In production these are set in Netlify → Project configuration → Environment variables.

# --- Website (safe to expose in the browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# --- Server-only (Netlify Functions) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Random string shared with the database so only our server can record orders.
ORDER_RPC_SECRET=generate-a-long-random-string
# Stripe TEST keys until Isaac switches to live mode.
STRIPE_SECRET_KEY=sk_test_xxx
# Optional: only needed if a Stripe webhook is set up.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Shipping (in cents). Defaults: $4.99 flat, free over $75.
SHIPPING_CENTS=499
FREE_SHIPPING_OVER_CENTS=7500
